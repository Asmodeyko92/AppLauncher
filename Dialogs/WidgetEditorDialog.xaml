<Window x:Class="AppLauncher.Dialogs.WidgetEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AppLauncher.Controls"
        xmlns:conv="clr-namespace:AppLauncher.Converters"
        Title="Редактор виджета" Width="1240" Height="760" MinWidth="1040" MinHeight="660"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        AllowsTransparency="False" Background="{DynamicResource DialogSurfaceBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" ShowInTaskbar="False"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <SolidColorBrush x:Key="DialogSurfaceBrush" Color="#FF181B24"/>
        <SolidColorBrush x:Key="DialogTextBrush" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="DialogMutedTextBrush" Color="#A8FFFFFF"/>
        <SolidColorBrush x:Key="DialogBorderBrush" Color="#30FFFFFF"/>
        <SolidColorBrush x:Key="DialogControlBrush" Color="#15FFFFFF"/>
        <SolidColorBrush x:Key="DialogHoverBrush" Color="#17FFFFFF"/>
        <SolidColorBrush x:Key="DialogAccentBrush" Color="#FF6E62FF"/>
        <SolidColorBrush x:Key="EditorScrollThumbBrush" Color="#5AFFFFFF"/>
        <conv:HexColorBrushConverter x:Key="HexColorBrushConverter"/>

        <Style x:Key="EditorInput" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource DialogControlBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DialogTextBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource DialogTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DialogBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource DialogAccentBrush}"/>
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource DialogHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="108"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Foreground" Value="{DynamicResource DialogTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource DialogControlBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DialogBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource DialogHoverBrush}"/>
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource DialogAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.58"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorIconButton" TargetType="Button" BasedOn="{StaticResource EditorButton}">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="38"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="EditorCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource DialogControlBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DialogBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DialogTextBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,13"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DialogTextBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="ValueLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DialogMutedTextBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="EditorComboItem" TargetType="ComboBoxItem">
            <Setter Property="MinHeight" Value="39"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="Foreground" Value="{DynamicResource DialogTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}" Margin="3,1">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource DialogHoverBrush}"/></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#357569FF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Foreground" Value="{DynamicResource DialogTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource DialogControlBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DialogBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource EditorComboItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Background="{TemplateBinding Background}" BorderThickness="0">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                                BorderBrush="{DynamicResource DialogBorderBrush}" BorderThickness="1" CornerRadius="8">
                                            <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       Foreground="{DynamicResource DialogMutedTextBrush}" FontSize="11"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource DialogHoverBrush}"/></Trigger>
                                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource DialogAccentBrush}"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="12,0,42,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Grid MinWidth="380" Margin="0,6,0,0">
                                    <Border Background="#01000000" CornerRadius="10">
                                        <Border.Effect><DropShadowEffect Color="#05070C" BlurRadius="22" ShadowDepth="4" Opacity="0.52"/></Border.Effect>
                                    </Border>
                                    <Border Background="{DynamicResource DialogSurfaceBrush}" BorderBrush="{DynamicResource DialogBorderBrush}"
                                            BorderThickness="1" CornerRadius="10" Padding="4">
                                        <ScrollViewer MaxHeight="245" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel IsItemsHost="True"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorScrollThumb" TargetType="Thumb">
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbSurface" Background="{DynamicResource EditorScrollThumbBrush}" CornerRadius="3"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbSurface" Property="Background" Value="{DynamicResource DialogAccentBrush}"/></Trigger>
                            <Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbSurface" Property="Opacity" Value="0.72"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Width="8" Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
                                <Track.Thumb><Thumb Style="{StaticResource EditorScrollThumb}"/></Track.Thumb>
                                <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NudgeButton" TargetType="Button">
            <Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="34"/><Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#A5222630"/>
            <Setter Property="BorderBrush" Value="#42FFFFFF"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/><Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="Opacity" Value="0.72"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="1"/><Setter TargetName="Surface" Property="BorderBrush" Value="#CC8B82FF"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.55"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource DialogSurfaceBrush}" BorderBrush="{DynamicResource DialogBorderBrush}"
            BorderThickness="1" CornerRadius="11" Padding="20">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="58"/></Grid.RowDefinitions>

            <Border Padding="14,0" Background="{DynamicResource DialogControlBrush}"
                    BorderBrush="{DynamicResource DialogBorderBrush}" BorderThickness="1" CornerRadius="11">
                <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Редактор виджета" Foreground="{DynamicResource DialogTextBrush}"
                                   FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="Содержимое, внешний вид и действия — в одном пространстве"
                                   Foreground="{DynamicResource DialogMutedTextBrush}" FontSize="11.5" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource EditorIconButton}" Content="&#xE8BB;"
                            ToolTip="Закрыть редактор" Click="Cancel_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0,10,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="430"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#08000000" BorderBrush="{DynamicResource DialogBorderBrush}"
                        BorderThickness="1" CornerRadius="11" Padding="4">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Margin="7,7,9,0" Padding="9,0" Background="#0AFFFFFF" CornerRadius="7">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           Foreground="{DynamicResource DialogAccentBrush}" FontSize="12"/>
                                <TextBlock Text="Параметры виджета" Margin="7,0,0,0"
                                           Foreground="{DynamicResource DialogMutedTextBrush}" FontSize="10.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                        <StackPanel Margin="7,7,9,7">
                            <Border Style="{StaticResource EditorCard}">
                                <StackPanel>
                                    <TextBlock Text="Основное" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Название" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditorInput}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource EditorCard}">
                                <StackPanel>
                                    <TextBlock Text="Содержимое" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Тип источника" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="ContentKindCombo" Style="{StaticResource EditorComboBox}"
                                              SelectionChanged="ContentKindCombo_SelectionChanged">
                                        <ComboBoxItem Tag="WebPage" Content="Веб-страница или отдельный блок"/>
                                        <ComboBoxItem Tag="TextFile" Content="Текстовый файл"/>
                                        <ComboBoxItem Tag="PdfFile" Content="Документ PDF"/>
                                        <ComboBoxItem Tag="ImageFile" Content="Изображение"/>
                                        <ComboBoxItem Tag="LauncherGrid" Content="Значки, ярлыки и папки"/>
                                    </ComboBox>

                                    <StackPanel x:Name="WebSourcePanel">
                                        <TextBlock Text="Адрес страницы" Style="{StaticResource FieldLabel}" Margin="0,13,0,6"/>
                                        <TextBox Text="{Binding WidgetUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditorInput}"
                                                 ToolTip="Например: https://example.com"/>
                                        <TextBlock Text="Можно вставить адрес без https:// — AppLauncher добавит его автоматически."
                                                   Foreground="{DynamicResource DialogMutedTextBrush}" FontSize="10" TextWrapping="Wrap" Margin="2,5,0,0"/>
                                    </StackPanel>

                                    <StackPanel x:Name="FileSourcePanel" Visibility="Collapsed">
                                        <TextBlock x:Name="ContentFileLabel" Text="Файл" Style="{StaticResource FieldLabel}" Margin="0,13,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding WidgetContentPath, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource EditorInput}" Margin="0,0,7,0"/>
                                            <Button Grid.Column="1" Content="Выбрать" Style="{StaticResource EditorButton}"
                                                    MinWidth="82" Padding="9,0" Click="BrowseContent_Click"/>
                                        </Grid>
                                        <TextBlock x:Name="ContentFileHint" Foreground="{DynamicResource DialogMutedTextBrush}"
                                                   FontSize="10" TextWrapping="Wrap" Margin="2,5,0,0"/>
                                    </StackPanel>

                                    <StackPanel x:Name="LauncherGridPanel" Visibility="Collapsed" Margin="0,13,0,0">
                                        <TextBlock Text="Отображение" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="LauncherDisplayModeCombo" Style="{StaticResource EditorComboBox}"
                                                  SelectionChanged="LauncherDisplayModeCombo_SelectionChanged">
                                            <ComboBoxItem Tag="Icons" Content="Значки — компактная сетка"/>
                                            <ComboBoxItem Tag="List" Content="Список — строки на всю ширину"/>
                                            <ComboBoxItem Tag="Tiles" Content="Плитки — широкие карточки"/>
                                        </ComboBox>

                                        <TextBlock Text="Папка-источник" Style="{StaticResource FieldLabel}" Margin="0,13,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding WidgetFolderPath, UpdateSourceTrigger=PropertyChanged}"
                                                     IsReadOnly="True" Style="{StaticResource EditorInput}" Margin="0,0,7,0"
                                                     ToolTip="Содержимое папки синхронизируется при открытии и наведении на виджет"/>
                                            <Button Grid.Column="1" Content="Выбрать" Style="{StaticResource EditorButton}"
                                                    MinWidth="82" Padding="9,0" Click="BrowseWidgetFolder_Click"/>
                                        </Grid>
                                        <Button Content="Отключить папку-источник" Style="{StaticResource EditorButton}"
                                                HorizontalAlignment="Stretch" Margin="0,7,0,0" Click="ClearWidgetFolder_Click"/>
                                        <TextBlock Text="Показываются все видимые файлы и подпапки. Содержимое обновляется автоматически."
                                                   Foreground="{DynamicResource DialogMutedTextBrush}" FontSize="10"
                                                   TextWrapping="Wrap" Margin="2,6,0,0"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Ручное содержимое" Style="{StaticResource FieldLabel}" Margin="0,13,0,6"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Children.Count, StringFormat={}{0} элементов}"
                                                       Foreground="{DynamicResource DialogMutedTextBrush}" FontSize="10.5" Margin="0,13,0,6"/>
                                        </Grid>
                                        <Grid IsEnabled="{Binding CanEditWidgetChildren}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Button Content="Добавить значки" Style="{StaticResource EditorButton}"
                                                    Margin="0,0,5,0" Click="AddWidgetApplications_Click"/>
                                            <Button Grid.Column="1" Content="Новая папка" Style="{StaticResource EditorButton}"
                                                    Margin="5,0,0,0" Click="AddWidgetFolder_Click"/>
                                        </Grid>
                                        <Grid Margin="0,13,0,0">
                                            <TextBlock Text="Размер значков" Style="{StaticResource FieldLabel}"/>
                                            <TextBlock x:Name="WidgetIconSizeValueText" Style="{StaticResource ValueLabel}"/>
                                        </Grid>
                                        <controls:NumericStepper x:Name="WidgetIconSizeSlider" Minimum="22" Maximum="96" Step="2"
                                                                 ValueChanged="WidgetIconSizeSlider_ValueChanged"/>
                                        <Button Content="Очистить внутреннюю сетку" Style="{StaticResource EditorButton}"
                                                IsEnabled="{Binding CanEditWidgetChildren}"
                                                HorizontalAlignment="Stretch" Margin="0,11,0,0" Click="ClearWidgetGrid_Click"/>
                                        <TextBlock Text="В предпросмотре значки можно переставлять мышью. Перетащите приложение на папку, чтобы вложить его внутрь."
                                                   Foreground="{DynamicResource DialogMutedTextBrush}" FontSize="10"
                                                   TextWrapping="Wrap" Margin="2,7,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border x:Name="ViewportPanel" Style="{StaticResource EditorCard}">
                                <StackPanel>
                                    <TextBlock Text="Область просмотра" Style="{StaticResource SectionTitle}"/>
                                    <StackPanel x:Name="CssSelectorPanel">
                                        <TextBlock Text="CSS-селектор блока" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding WidgetCssSelector, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditorInput}"
                                                 ToolTip="Например: #weather или .news-card"/>
                                        <TextBlock Text="Оставьте пустым для всей страницы: #weather, .forecast, main."
                                                   Foreground="{DynamicResource DialogMutedTextBrush}" FontSize="10" TextWrapping="Wrap" Margin="2,5,0,9"/>
                                    </StackPanel>

                                    <Grid><TextBlock Text="Масштаб" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="ScaleValueText" Style="{StaticResource ValueLabel}"/></Grid>
                                    <controls:NumericStepper x:Name="ScaleSlider" Minimum="25" Maximum="300" Step="5"
                                                             ValueChanged="PreviewSlider_ValueChanged"/>

                                    <Grid Margin="0,11,0,0"><TextBlock Text="По горизонтали" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="OffsetXValueText" Style="{StaticResource ValueLabel}"/></Grid>
                                    <controls:NumericStepper x:Name="OffsetXSlider" Minimum="-1000" Maximum="1000" Step="1"
                                                             ValueChanged="PreviewSlider_ValueChanged"/>

                                    <Grid Margin="0,11,0,0"><TextBlock Text="По вертикали" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="OffsetYValueText" Style="{StaticResource ValueLabel}"/></Grid>
                                    <controls:NumericStepper x:Name="OffsetYSlider" Minimum="-1000" Maximum="1000" Step="1"
                                                             ValueChanged="PreviewSlider_ValueChanged"/>

                                    <Button Content="Сбросить область просмотра" Style="{StaticResource EditorButton}"
                                            HorizontalAlignment="Stretch" Margin="0,13,0,0" Click="ResetViewport_Click"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource EditorCard}">
                                <StackPanel>
                                    <TextBlock Text="Оформление" Style="{StaticResource SectionTitle}"/>
                                    <Grid Margin="0,0,0,13">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Фон виджета" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding WidgetBackgroundColor}" Foreground="{DynamicResource DialogMutedTextBrush}" FontSize="10"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource EditorButton}" Click="ChooseWidgetBackground_Click" Padding="10,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="20" Height="20" CornerRadius="6" Margin="0,0,8,0"
                                                        Background="{Binding WidgetBackgroundColor, Converter={StaticResource HexColorBrushConverter}}"
                                                        BorderBrush="{DynamicResource DialogBorderBrush}" BorderThickness="1"/>
                                                <TextBlock Text="Выбрать" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <CheckBox Content="Фон следует выбранной теме" Margin="0,0,0,13"
                                              Style="{StaticResource ToggleSwitch}"
                                              IsChecked="{Binding WidgetBackgroundFollowsTheme, Mode=TwoWay}"/>
                                    <Grid><TextBlock Text="Прозрачность содержимого" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="OpacityValueText" Style="{StaticResource ValueLabel}"/></Grid>
                                    <controls:NumericStepper x:Name="ContentOpacitySlider" Minimum="20" Maximum="100" Step="5"
                                                             ValueChanged="PreviewSlider_ValueChanged"/>
                                    <CheckBox x:Name="ShowTitleCheckBox" Content="Показывать название поверх содержимого" Margin="0,14,0,0"
                                              Style="{StaticResource ToggleSwitch}" IsChecked="{Binding WidgetShowTitle, Mode=TwoWay}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource EditorCard}" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="Действие" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Левый клик по виджету" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text="Оставьте поле пустым — тогда левый клик ничего не делает."
                                               Foreground="{DynamicResource DialogMutedTextBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding WidgetClickActionPath, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource EditorInput}" Margin="0,0,7,0"
                                                 ToolTip="Программа, ярлык, документ или системная команда"/>
                                        <Button Grid.Column="1" Content="Выбрать" Style="{StaticResource EditorButton}"
                                                MinWidth="82" Padding="9,0" Click="BrowseClickAction_Click"/>
                                    </Grid>
                                    <TextBlock Text="Аргументы запуска" Style="{StaticResource FieldLabel}" Margin="0,11,0,6"/>
                                    <TextBox Text="{Binding WidgetClickArguments, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditorInput}"/>
                                    <Button Content="Очистить действие" Style="{StaticResource EditorButton}"
                                            HorizontalAlignment="Stretch" Margin="0,9,0,0" Click="ClearClickAction_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Background="#08000000" BorderBrush="{DynamicResource DialogBorderBrush}"
                        BorderThickness="1" CornerRadius="11" Padding="11">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid Margin="4,0,4,9">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Предпросмотр" Foreground="{DynamicResource DialogTextBrush}" FontSize="13.5" FontWeight="SemiBold"/>
                                <Border Margin="10,0,0,0" Padding="8,3" CornerRadius="7" Background="#1427B878">
                                    <TextBlock Text="Живое редактирование" Foreground="{DynamicResource DialogPositiveBrush}" FontSize="10"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="PreviewSizeText"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{DynamicResource DialogMutedTextBrush}" FontSize="10.5"/>
                        </Grid>

                        <Border Grid.Row="1" Background="#05000000" BorderBrush="{DynamicResource DialogBorderBrush}"
                                BorderThickness="1" CornerRadius="9" ClipToBounds="True">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                         PanningMode="Both" Padding="12">
                                <Border x:Name="PreviewWidgetFrame"
                                       HorizontalAlignment="Left" VerticalAlignment="Top"
                                       Background="{Binding WidgetBackgroundColor, Converter={StaticResource HexColorBrushConverter}}"
                                       BorderBrush="{DynamicResource DialogBorderBrush}"
                                       BorderThickness="1" CornerRadius="9" ClipToBounds="True">
                                   <Grid>
                                       <Grid x:Name="PreviewContentHost">
                                           <Grid.RenderTransform><TranslateTransform x:Name="PreviewContentTranslate"/></Grid.RenderTransform>
                                           <controls:WebWidgetView x:Name="PreviewWidgetView" DataContext="{Binding}" Margin="1"/>
                                           <controls:WidgetLauncherGridView x:Name="PreviewLauncherGrid" DataContext="{Binding}"
                                                                                 IsEditing="True" Margin="8,42,8,8"
                                                                                 Opacity="{Binding WidgetContentOpacity}"
                                                                                 Visibility="Collapsed"/>
                                       </Grid>

                                       <Border x:Name="PreviewTitleSurface" VerticalAlignment="Top" Padding="13,9"
                                               Background="#B8171A22" IsHitTestVisible="False" Panel.ZIndex="2">
                                           <TextBlock Text="{Binding Name}" Foreground="White" FontSize="12.5" FontWeight="SemiBold"
                                                      TextTrimming="CharacterEllipsis"/>
                                       </Border>

                                       <Border x:Name="PreviewDragSurface" Background="#01000000" Cursor="SizeAll" Panel.ZIndex="3"
                                               MouseLeftButtonDown="Preview_MouseLeftButtonDown"
                                               MouseMove="Preview_MouseMove"
                                               MouseLeftButtonUp="Preview_MouseLeftButtonUp"
                                               LostMouseCapture="Preview_LostMouseCapture"
                                               PreviewMouseWheel="Preview_MouseWheel"/>

                                       <Border x:Name="PreviewDragHint" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="13"
                                               Padding="10,6" CornerRadius="8" Background="#98212630"
                                               BorderBrush="#30FFFFFF" BorderThickness="1" IsHitTestVisible="False" Panel.ZIndex="4">
                                           <StackPanel Orientation="Horizontal">
                                               <TextBlock Text="&#xE7C2;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                          Foreground="#FF9B94FF" FontSize="13" VerticalAlignment="Center"/>
                                               <TextBlock Text="  Перетащите для позиционирования" Foreground="White" FontSize="10.5" VerticalAlignment="Center"/>
                                           </StackPanel>
                                       </Border>

                                       <Grid x:Name="PreviewNudgePad" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="14"
                                             Width="106" Height="106" Panel.ZIndex="6">
                                           <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                           <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                           <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource NudgeButton}" Content="&#xE70E;" Tag="Up" Click="NudgeViewport_Click" ToolTip="Вверх"/>
                                           <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource NudgeButton}" Content="&#xE76B;" Tag="Left" Click="NudgeViewport_Click" ToolTip="Влево"/>
                                           <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource NudgeButton}" Content="&#xE777;" Tag="Reset" Click="NudgeViewport_Click" ToolTip="Сбросить смещение"/>
                                           <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource NudgeButton}" Content="&#xE76C;" Tag="Right" Click="NudgeViewport_Click" ToolTip="Вправо"/>
                                           <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource NudgeButton}" Content="&#xE70D;" Tag="Down" Click="NudgeViewport_Click" ToolTip="Вниз"/>
                                       </Grid>
                                   </Grid>
                                </Border>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="2">
                <Border BorderBrush="{DynamicResource DialogBorderBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,10"/>
                <TextBlock x:Name="ValidationText" Foreground="#FFFF667A" FontSize="11.5"
                           VerticalAlignment="Bottom" Margin="3,0,240,10" Visibility="Collapsed"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <Button Content="Отмена" Style="{StaticResource EditorButton}" Foreground="{DynamicResource DialogNegativeBrush}" Margin="0,0,9,0" Click="Cancel_Click"/>
                    <Button Content="Сохранить" Style="{StaticResource EditorButton}" Background="{DynamicResource DialogPositiveBrush}"
                            BorderBrush="Transparent" Click="Save_Click" IsDefault="True"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
