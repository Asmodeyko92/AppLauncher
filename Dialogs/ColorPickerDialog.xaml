<Window x:Class="AppLauncher.Dialogs.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор цвета" Width="680" Height="670"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        AllowsTransparency="False" Background="#FF181B24" ShowInTaskbar="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#15FFFFFF"/>
            <Setter Property="BorderBrush" Value="#24FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.82"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.58"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColorSwatchButton" TargetType="Button">
            <Setter Property="Width" Value="43"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderBrush" Value="#30FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Swatch" Margin="2" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Swatch" Property="BorderBrush" Value="White"/>
                                <Setter TargetName="Swatch" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Swatch" Property="Opacity" Value="0.62"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HexInput" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#0FFFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderBrush" Value="#2AFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputSurface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="InputSurface" Property="BorderBrush" Value="#7C6AFF"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#FF181B24" BorderBrush="#30FFFFFF" BorderThickness="1"
            CornerRadius="11" Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="270"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <StackPanel>
                    <TextBlock x:Name="TitleText" Foreground="White" FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="Выберите оттенок, насыщенность и яркость"
                               Margin="0,4,0,0" Foreground="#A8FFFFFF"
                               FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Width="38" Height="38"
                        Content="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                        FontSize="14" Style="{StaticResource DialogButton}" MinWidth="38" Padding="0"
                        ToolTip="Закрыть" Click="Cancel_Click"/>
            </Grid>

            <Grid Grid.Row="1" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="390"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid x:Name="SaturationValueArea" Grid.Column="0" ClipToBounds="True" Cursor="Cross"
                      Background="Transparent" MouseLeftButtonDown="SaturationValue_MouseLeftButtonDown"
                      MouseMove="SaturationValue_MouseMove" MouseLeftButtonUp="SaturationValue_MouseLeftButtonUp">
                    <Rectangle x:Name="HueSurface" RadiusX="8" RadiusY="8"/>
                    <Rectangle RadiusX="8" RadiusY="8">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="White" Offset="0"/>
                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle RadiusX="8" RadiusY="8">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                <GradientStop Color="#00000000" Offset="0"/>
                                <GradientStop Color="Black" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Canvas IsHitTestVisible="False">
                        <Ellipse x:Name="SaturationValueThumb" Width="18" Height="18" Fill="Transparent"
                                 Stroke="White" StrokeThickness="2">
                            <Ellipse.Effect><DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="1" Opacity="0.75"/></Ellipse.Effect>
                        </Ellipse>
                    </Canvas>
                </Grid>

                <Grid x:Name="HueArea" Grid.Column="2" ClipToBounds="True" Cursor="SizeNS"
                      MouseLeftButtonDown="Hue_MouseLeftButtonDown" MouseMove="Hue_MouseMove"
                      MouseLeftButtonUp="Hue_MouseLeftButtonUp">
                    <Rectangle RadiusX="6" RadiusY="6">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                <GradientStop Color="#FFFF0000" Offset="0"/>
                                <GradientStop Color="#FFFFFF00" Offset="0.1667"/>
                                <GradientStop Color="#FF00FF00" Offset="0.3333"/>
                                <GradientStop Color="#FF00FFFF" Offset="0.5"/>
                                <GradientStop Color="#FF0000FF" Offset="0.6667"/>
                                <GradientStop Color="#FFFF00FF" Offset="0.8333"/>
                                <GradientStop Color="#FFFF0000" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Canvas IsHitTestVisible="False">
                        <Border x:Name="HueThumb" Width="34" Height="7" Margin="-2,0,0,0"
                                BorderBrush="White" BorderThickness="2" CornerRadius="3" Background="Transparent">
                            <Border.Effect><DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="1" Opacity="0.8"/></Border.Effect>
                        </Border>
                    </Canvas>
                </Grid>

                <StackPanel Grid.Column="4">
                    <Border x:Name="PreviewSwatch" Height="92" CornerRadius="12"
                            BorderBrush="#40FFFFFF" BorderThickness="1"/>
                    <TextBlock Text="HEX" Margin="0,13,0,5" Foreground="#A8FFFFFF" FontSize="11"/>
                    <TextBox x:Name="HexTextBox" Style="{StaticResource HexInput}"
                             TextChanged="HexTextBox_TextChanged" MaxLength="9"/>
                    <TextBlock x:Name="RgbText" Margin="0,10,0,0" Foreground="#A8FFFFFF"
                               FontFamily="Cascadia Mono, Consolas" FontSize="11"/>
                    <Button Margin="0,14,0,0" Content="Сохранить цвет" Style="{StaticResource DialogButton}"
                            Click="SaveColor_Click"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="2" Margin="0,17,0,0">
                <TextBlock Text="Быстрые цвета" Foreground="White" FontWeight="SemiBold"/>
                <UniformGrid Columns="12" HorizontalAlignment="Left" Margin="0,6,0,0">
                    <Button Style="{StaticResource ColorSwatchButton}" Background="#11131A" Tag="#11131A" Click="PaletteColor_Click"/>
                    <Button Style="{StaticResource ColorSwatchButton}" Background="#F7F8FC" Tag="#F7F8FC" Click="PaletteColor_Click"/>
                    <Button Style="{StaticResource ColorSwatchButton}" Background="#6E62FF" Tag="#6E62FF" Click="PaletteColor_Click"/>
                    <Button Style="{StaticResource ColorSwatchButton}" Background="#3E80FF" Tag="#3E80FF" Click="PaletteColor_Click"/>
                    <Button Style="{StaticResource ColorSwatchButton}" Background="#00A2ED" Tag="#00A2ED" Click="PaletteColor_Click"/>
                    <Button Style="{StaticResource ColorSwatchButton}" Background="#16A085" Tag="#16A085" Click="PaletteColor_Click"/>
                    <Button Style="{StaticResource ColorSwatchButton}" Background="#26A269" Tag="#26A269" Click="PaletteColor_Click"/>
                    <Button Style="{StaticResource ColorSwatchButton}" Background="#F9C74F" Tag="#F9C74F" Click="PaletteColor_Click"/>
                    <Button Style="{StaticResource ColorSwatchButton}" Background="#F3722C" Tag="#F3722C" Click="PaletteColor_Click"/>
                    <Button Style="{StaticResource ColorSwatchButton}" Background="#E5484D" Tag="#E5484D" Click="PaletteColor_Click"/>
                    <Button Style="{StaticResource ColorSwatchButton}" Background="#D62976" Tag="#D62976" Click="PaletteColor_Click"/>
                    <Button Style="{StaticResource ColorSwatchButton}" Background="#B45AC8" Tag="#B45AC8" Click="PaletteColor_Click"/>
                </UniformGrid>
            </StackPanel>

            <Border Grid.Row="3" Height="1" Margin="0,14,0,12" Background="#20FFFFFF"/>

            <Grid Grid.Row="4">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="Сохранённые цвета" Foreground="White" FontWeight="SemiBold"/>
                    <TextBlock Text="ПКМ — удалить" HorizontalAlignment="Right" Foreground="#78FFFFFF" FontSize="10.5"/>
                </Grid>
                <ScrollViewer Grid.Row="1" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <WrapPanel x:Name="SavedColorsPanel"/>
                </ScrollViewer>
            </Grid>

            <Grid Grid.Row="5" Margin="0,14,0,0">
                <TextBlock x:Name="ErrorText" Text="Введите цвет вида #RRGGBB" Foreground="#FF7588"
                           FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="11"
                           VerticalAlignment="Center" Visibility="Collapsed"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Отмена" Style="{StaticResource DialogButton}" Margin="0,0,9,0" Click="Cancel_Click"/>
                    <Button Content="Применить" Style="{StaticResource DialogButton}" Background="#6E62FF"
                            BorderBrush="Transparent" IsDefault="True" Click="Apply_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
