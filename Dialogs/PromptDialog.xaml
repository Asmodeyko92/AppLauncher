<Window x:Class="AppLauncher.Dialogs.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AppLauncher"
        Width="450" Height="252"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        AllowsTransparency="False" Background="{DynamicResource DialogSurfaceBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        ShowInTaskbar="False">
    <Window.Resources>
        <SolidColorBrush x:Key="DialogSurfaceBrush" Color="#FF181B24"/>
        <SolidColorBrush x:Key="DialogTextBrush" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="DialogMutedTextBrush" Color="#A8FFFFFF"/>
        <SolidColorBrush x:Key="DialogBorderBrush" Color="#30FFFFFF"/>
        <SolidColorBrush x:Key="DialogControlBrush" Color="#15FFFFFF"/>
        <SolidColorBrush x:Key="DialogHoverBrush" Color="#17FFFFFF"/>
        <SolidColorBrush x:Key="DialogAccentBrush" Color="#FF6E62FF"/>

        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Width" Value="108"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Foreground" Value="{DynamicResource DialogTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource DialogControlBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DialogBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.58"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundedTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource DialogControlBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DialogTextBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource DialogTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DialogBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputSurface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputSurface" Property="BorderBrush" Value="{DynamicResource DialogAccentBrush}"/>
                                <Setter TargetName="InputSurface" Property="Background" Value="{DynamicResource DialogHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="0" Background="{DynamicResource DialogSurfaceBrush}"
            BorderBrush="{DynamicResource DialogBorderBrush}" BorderThickness="1"
            CornerRadius="10" Padding="26">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock x:Name="TitleText" Foreground="{DynamicResource DialogTextBrush}"
                           FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock x:Name="MessageText" Margin="0,6,0,0" Foreground="{DynamicResource DialogMutedTextBrush}"
                           FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12.5" TextWrapping="Wrap"/>
            </StackPanel>

            <TextBox x:Name="ValueTextBox" Grid.Row="1" Margin="0,18,0,0" Style="{StaticResource RoundedTextBox}"/>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,18,0,0">
                <Button Content="Отмена" Style="{StaticResource DialogButton}" Margin="0,0,9,0" Click="Cancel_Click"/>
                <Button Content="Готово" Style="{StaticResource DialogButton}" Background="{DynamicResource DialogAccentBrush}"
                        BorderBrush="Transparent" Click="Ok_Click" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
